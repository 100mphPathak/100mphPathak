# Supabase Postgres: Connect > Transaction pooler URI (port 6543), with your database password
DATABASE_URL=
# Supabase project: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase Storage S3 access key: Storage > Settings > S3 access keys
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=ap-south-1
MEDIA_BUCKET=media
# Where admin links in emails point (no trailing slash). Production: https://www.pathak100mph.com
ADMIN_ORIGIN=
# Lets scripts/publish-defaults.mjs clear the live cache: any long random string
REVALIDATE_SECRET=
# Vercel Cron sends this to /api/keep-alive: any long random string
CRON_SECRET=
