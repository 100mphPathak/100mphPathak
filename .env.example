# Neon Postgres (pooled connection string)
DATABASE_URL=
# Neon Auth (Managed Better Auth) — Neon Console > Auth
NEON_AUTH_BASE_URL=
# 32+ random characters: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEON_AUTH_COOKIE_SECRET=
# Neon Object Storage credential (storage:read + storage:write)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=ap-southeast-1
MEDIA_BUCKET=media
# Where admin links in emails point (no trailing slash). Production: https://www.pathak100mph.com
ADMIN_ORIGIN=
# Lets scripts/publish-defaults.mjs clear the live cache: any long random string
REVALIDATE_SECRET=
